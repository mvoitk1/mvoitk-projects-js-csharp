@model Catalog.Web.Dtos.v1.Admin.AdminCollectionWriteDto
@{
    ViewData["Title"] = "Edit Collection";
}

<p class="text-muted mb-3">Update collection names, launch date, and storefront visibility here.</p>
<a asp-action="Index" class="text-decoration-none text-muted mb-4 d-inline-block">← Back to Collections</a>

<div class="admin-form-grid">
    <div class="admin-form-panel">
        <form asp-action="Edit" method="post" style="max-width:680px;">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_CollectionForm" model="Model"/>
            <button type="submit" class="btn btn-dark mt-3">Save Collection</button>
        </form>
    </div>
    <aside class="admin-form-aside">
        <h3 class="h6">Test check</h3>
        <p class="text-muted small mb-0">After saving, verify the edited names, description, launch date, and active status in the collections list.</p>
    </aside>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial"/> }
