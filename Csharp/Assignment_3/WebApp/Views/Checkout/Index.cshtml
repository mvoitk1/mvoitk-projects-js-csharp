@model WebApp.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<h2>Checkout</h2>

<form asp-action="Confirm" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- Shipping form -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Shipping Details</h5>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ShippingFirstName" class="form-label"></label>
                            <input asp-for="ShippingFirstName" class="form-control">
                            <span asp-validation-for="ShippingFirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ShippingLastName" class="form-label"></label>
                            <input asp-for="ShippingLastName" class="form-control">
                            <span asp-validation-for="ShippingLastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ShippingEmail" class="form-label"></label>
                            <input asp-for="ShippingEmail" class="form-control" type="email">
                            <span asp-validation-for="ShippingEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ShippingPhone" class="form-label"></label>
                            <input asp-for="ShippingPhone" class="form-control" type="tel">
                            <span asp-validation-for="ShippingPhone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ShippingStreet" class="form-label"></label>
                            <input asp-for="ShippingStreet" class="form-control">
                            <span asp-validation-for="ShippingStreet" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ShippingCity" class="form-label"></label>
                            <input asp-for="ShippingCity" class="form-control">
                            <span asp-validation-for="ShippingCity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ShippingPostalCode" class="form-label"></label>
                            <input asp-for="ShippingPostalCode" class="form-control">
                            <span asp-validation-for="ShippingPostalCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ShippingCountry" class="form-label"></label>
                            <input asp-for="ShippingCountry" class="form-control">
                            <span asp-validation-for="ShippingCountry" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order summary -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Your Order (@Model.Cart.ItemCount items)</h5>
                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="d-flex justify-content-between mb-2 small">
                            <span>@item.ProductName — @item.ColorName / @item.SizeCode × @item.Quantity</span>
                            <span>@item.LineTotal.ToString("C")</span>
                        </div>
                    }
                    <hr>
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total</span>
                        <span>@Model.Cart.Total.ToString("C")</span>
                    </div>
                    <button type="submit" class="btn btn-dark w-100 mt-3 btn-lg">Place Order</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
