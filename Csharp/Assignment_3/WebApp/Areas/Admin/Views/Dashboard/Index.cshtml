@model WebApp.Areas.Admin.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="admin-summary-card">
            <p class="text-muted small mb-1">Products</p>
            <p class="fs-2 fw-bold mb-2">@Model.ProductCount</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-dark">Manage</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-summary-card">
            <p class="text-muted small mb-1">Total Orders</p>
            <p class="fs-2 fw-bold mb-2">@Model.OrderCount</p>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-dark">View</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-summary-card">
            <p class="text-muted small mb-1">Low Stock (&lt;5)</p>
            <p class="fs-2 fw-bold mb-2 text-warning">@Model.LowStockCount</p>
            <a asp-controller="Stock" asp-action="Index" class="btn btn-sm btn-outline-warning">Fix Stock</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-summary-card">
            <p class="text-muted small mb-1">Orders (last 24h)</p>
            <p class="fs-2 fw-bold mb-2 text-success">@Model.RecentOrderCount</p>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-success">View</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="admin-section-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <p class="admin-eyebrow mb-1">Start here</p>
                    <h3 class="h4 mb-1">Create catalog items quickly</h3>
                    <p class="text-muted mb-0">Open the exact form you need without hunting through the admin lists.</p>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded-2 p-3 h-100">
                        <h4 class="h6">Products</h4>
                        <p class="text-muted small mb-3">Add a sellable item, assign categories, then add variants and images.</p>
                        <a asp-controller="Products" asp-action="Create" class="btn btn-dark btn-sm">Create Product</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded-2 p-3 h-100">
                        <h4 class="h6">Categories</h4>
                        <p class="text-muted small mb-3">Build the product taxonomy first if you need new product grouping.</p>
                        <a asp-controller="Categories" asp-action="Create" class="btn btn-outline-dark btn-sm">Create Category</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded-2 p-3 h-100">
                        <h4 class="h6">Collections</h4>
                        <p class="text-muted small mb-3">Add seasonal or launch-based groupings before linking products to them.</p>
                        <a asp-controller="Collections" asp-action="Create" class="btn btn-outline-dark btn-sm">Create Collection</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="admin-section-card h-100">
            <p class="admin-eyebrow mb-1">Recommended flow</p>
            <h3 class="h4 mb-3">Catalog setup order</h3>
            <ol class="mb-0 ps-3">
                <li class="mb-2">Create categories to define where products should appear.</li>
                <li class="mb-2">Create collections for drops, seasons, or campaigns.</li>
                <li>Create products, then add variants and images from the product edit page.</li>
            </ol>
        </div>
    </div>
</div>
