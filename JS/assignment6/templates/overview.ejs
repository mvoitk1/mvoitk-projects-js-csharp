<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Overview — assignment6 api</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #222; }
    h1 { margin: 0 0 0.25rem; }
    .subtitle { color: #666; margin-bottom: 2rem; }
    h2 { margin-top: 2rem; border-bottom: 1px solid #ddd; padding-bottom: 0.25rem; }
    table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
    th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #eee; vertical-align: top; }
    th { background: #f5f5f5; }
    tr:nth-child(even) td { background: #fafafa; }
    .muted { color: #888; }
    .empty { color: #888; font-style: italic; }
    .badge { display: inline-block; padding: 0 0.4rem; border-radius: 4px; font-size: 0.8rem; }
    .badge-on  { background: #d6f5d6; color: #195c19; }
    .badge-off { background: #f0f0f0; color: #555; }
    code { font-family: ui-monospace, monospace; font-size: 0.85em; color: #555; }
  </style>
</head>
<body>
  <h1>Overview</h1>
  <p class="subtitle">Everything created on this backend, grouped by resource, with owners.</p>

  <h2>Tasks (<%= tasks.length %>)</h2>
  <% if (tasks.length === 0) { %>
    <p class="empty">No tasks yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Task</th>
          <th>Owner</th>
          <th>Category</th>
          <th>Priority</th>
          <th>Done</th>
          <th>Archived</th>
          <th>Due</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% tasks.forEach(function(t) { %>
          <tr>
            <td><%= t.taskName ?? '' %><br /><code><%= t.id %></code></td>
            <td><%= t.owner %></td>
            <td><%= t.categoryName ?? '' %></td>
            <td><%= t.priorityName ?? '' %></td>
            <td><span class="badge <%= t.isCompleted ? 'badge-on' : 'badge-off' %>"><%= t.isCompleted ? 'yes' : 'no' %></span></td>
            <td><span class="badge <%= t.isArchived ? 'badge-on' : 'badge-off' %>"><%= t.isArchived ? 'yes' : 'no' %></span></td>
            <td><%= t.dueDt ?? '' %></td>
            <td><%= t.createdDt %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <h2>Categories (<%= categories.length %>)</h2>
  <% if (categories.length === 0) { %>
    <p class="empty">No categories yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Owner</th>
          <th>Sort</th>
          <th>Tag</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(function(c) { %>
          <tr>
            <td><%= c.categoryName ?? '' %><br /><code><%= c.id %></code></td>
            <td><%= c.owner %></td>
            <td><%= c.categorySort %></td>
            <td><%= c.tag ?? '' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <h2>Priorities (<%= priorities.length %>)</h2>
  <% if (priorities.length === 0) { %>
    <p class="empty">No priorities yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Owner</th>
          <th>Sort</th>
        </tr>
      </thead>
      <tbody>
        <% priorities.forEach(function(p) { %>
          <tr>
            <td><%= p.priorityName ?? '' %><br /><code><%= p.id %></code></td>
            <td><%= p.owner %></td>
            <td><%= p.prioritySort %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
