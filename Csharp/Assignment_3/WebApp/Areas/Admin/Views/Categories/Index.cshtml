@model IEnumerable<App.DTO.v1.Admin.AdminCategoryDto>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="admin-eyebrow mb-1">Catalog structure</p>
        <p class="text-muted mb-0">Create product categories here so products can be grouped correctly in the shop.</p>
    </div>
    <a asp-action="Create" class="btn btn-dark">New Category</a>
</div>

@if (!Model.Any())
{
    <div class="admin-empty-state">
        <h3 class="h5 mb-2">No categories yet</h3>
        <p class="text-muted mb-3">Create a category before assigning products to it.</p>
        <a asp-action="Create" class="btn btn-dark">Create Category</a>
    </div>
}
else
{
    <div class="table-responsive admin-table-wrap">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name (EN)</th>
                    <th>Name (ET)</th>
                    <th>Parent</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.NameEn</td>
                        <td>@cat.NameEt</td>
                        <td>@(cat.ParentCategoryName ?? "—")</td>
                        <td class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                            <form asp-action="Delete" asp-route-id="@cat.Id" method="post"
                                  onsubmit="return confirm('Delete @cat.NameEn?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
