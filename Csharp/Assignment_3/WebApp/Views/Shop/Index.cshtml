@model WebApp.ViewModels.ShopIndexViewModel
@{
    ViewData["Title"] = "Shop";
}

<div class="row">
    <!-- Sidebar -->
    <div class="col-md-3">
        <div class="filter-sidebar">
            <h6>Category</h6>
            <a asp-controller="Shop" asp-action="Index"
               class="@(Model.SelectedCategoryId == null ? "active-filter" : "")">All</a>
            @foreach (var cat in Model.Categories)
            {
                <a asp-controller="Shop" asp-action="Index"
                   asp-route-categoryId="@cat.Id"
                   asp-route-collectionId="@Model.SelectedCollectionId"
                   asp-route-gender="@Model.SelectedGender"
                   class="@(Model.SelectedCategoryId == cat.Id ? "active-filter" : "")">
                    @cat.Name
                </a>
                @foreach (var sub in cat.SubCategories)
                {
                    <a asp-controller="Shop" asp-action="Index"
                       asp-route-categoryId="@sub.Id"
                       asp-route-collectionId="@Model.SelectedCollectionId"
                       asp-route-gender="@Model.SelectedGender"
                       class="ps-3 @(Model.SelectedCategoryId == sub.Id ? "active-filter" : "")">
                        @sub.Name
                    </a>
                }
            }

            <h6>Collection</h6>
            <a asp-controller="Shop" asp-action="Index"
               asp-route-categoryId="@Model.SelectedCategoryId"
               asp-route-gender="@Model.SelectedGender"
               class="@(Model.SelectedCollectionId == null ? "active-filter" : "")">All</a>
            @foreach (var col in Model.Collections)
            {
                <a asp-controller="Shop" asp-action="Index"
                   asp-route-collectionId="@col.Id"
                   asp-route-categoryId="@Model.SelectedCategoryId"
                   asp-route-gender="@Model.SelectedGender"
                   class="@(Model.SelectedCollectionId == col.Id ? "active-filter" : "")">
                    @col.Name
                </a>
            }

            <h6>Gender</h6>
            @foreach (var g in new[] { ("", "All"), ("Men", "Men"), ("Women", "Women"), ("Unisex", "Unisex") })
            {
                <a asp-controller="Shop" asp-action="Index"
                   asp-route-gender="@g.Item1"
                   asp-route-categoryId="@Model.SelectedCategoryId"
                   asp-route-collectionId="@Model.SelectedCollectionId"
                   class="@(Model.SelectedGender == g.Item1 ? "active-filter" : "")">
                    @g.Item2
                </a>
            }
        </div>
    </div>

    <!-- Product grid -->
    <div class="col-md-9">
        <p class="text-muted small mb-3">@Model.Products.Count() products</p>
        @if (!Model.Products.Any())
        {
            <p class="text-muted">No products found.</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-6 col-md-4">
                        <a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.Id"
                           class="text-decoration-none text-dark">
                            <div class="card h-100 border-0 shadow-sm">
                                @if (!string.IsNullOrEmpty(product.PrimaryImageUrl))
                                {
                                    <img src="@product.PrimaryImageUrl" class="card-img-top" alt="@product.Name"
                                         style="height:260px;object-fit:cover;">
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                         style="height:260px;">
                                        <span class="text-muted">No image</span>
                                    </div>
                                }
                                <div class="card-body">
                                    <h6 class="card-title mb-1">@product.Name</h6>
                                    <small class="text-muted">@product.Gender</small>
                                    @if (product.LowestPrice.HasValue)
                                    {
                                        <p class="mt-1 fw-semibold mb-0">From @product.LowestPrice.Value.ToString("C")</p>
                                    }
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>
