@model Catalog.Web.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<div class="home-hero mt-4">
    <h1>@App.Resources.Views.Home.Index.HeroTitle</h1>
    <p>@App.Resources.Views.Home.Index.HeroSubtitle</p>
    <a asp-area="" asp-controller="Shop" asp-action="Index" class="btn btn-dark btn-lg">@App.Resources.Views.Home.Index.ShopNow</a>
</div>

<!-- Collections -->
@if (Model.Collections.Any())
{
    <section class="mb-5">
        <div class="section-header">
            <h2 class="section-heading">@App.Resources.Views.Home.Index.Collections</h2>
        </div>
        <div class="row g-3">
            @foreach (var collection in Model.Collections)
            {
                <div class="col-md-4">
                    <a asp-area="" asp-controller="Shop" asp-action="Index" asp-route-collectionId="@collection.Id"
                       class="collection-card">
                        <h3 class="collection-card-title">@collection.Name</h3>
                        @if (!string.IsNullOrEmpty(collection.Description))
                        {
                            <p class="collection-card-desc">@collection.Description</p>
                        }
                        <span class="btn btn-dark btn-sm">@App.Resources.Views.Home.Index.ViewCollection</span>
                    </a>
                </div>
            }
        </div>
    </section>
}

<!-- Featured Products -->
<section class="mb-5">
    <div class="section-header">
        <h2 class="section-heading">@App.Resources.Views.Home.Index.FeaturedProducts</h2>
        <a asp-area="" asp-controller="Shop" asp-action="Index" class="text-decoration-none" style="font-size:0.8rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--c-text-muted);">@App.Resources.Views.Home.Index.ViewAll →</a>
    </div>
    <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="col">
                <a asp-area="" asp-controller="Shop" asp-action="Detail" asp-route-id="@product.Id" class="product-card">
                    <div class="product-card-img-wrap">
                        @if (!string.IsNullOrEmpty(product.PrimaryImageUrl))
                        {
                            <img src="@product.PrimaryImageUrl" alt="@product.Name">
                        }
                        else
                        {
                            <div class="product-card-img-placeholder">@App.Resources.Views.Home.Index.NoImage</div>
                        }
                    </div>
                    <p class="product-card-name">@product.Name</p>
                    @if (product.LowestPrice.HasValue)
                    {
                        <p class="product-card-price">@App.Resources.Views.Home.Index.From @product.LowestPrice.Value.ToString("C")</p>
                    }
                </a>
            </div>
        }
    </div>
</section>

<!-- Categories -->
@if (Model.Categories.Any())
{
    <section class="mb-5">
        <div class="section-header">
            <h2 class="section-heading">@App.Resources.Views.Home.Index.ShopByCategory</h2>
        </div>
        <div class="row g-3">
            @foreach (var category in Model.Categories)
            {
                <div class="col-6 col-md-3">
                    <a asp-area="" asp-controller="Shop" asp-action="Index" asp-route-categoryId="@category.Id"
                       class="category-card">
                        <span class="category-card-name">@category.Name</span>
                    </a>
                </div>
            }
        </div>
    </section>
}
