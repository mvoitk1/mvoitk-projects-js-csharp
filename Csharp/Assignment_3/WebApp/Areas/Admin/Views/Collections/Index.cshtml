@model IEnumerable<App.DTO.v1.Admin.AdminCollectionDto>
@{
    ViewData["Title"] = "Collections";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Collections</h2>
    <a asp-action="Create" class="btn btn-dark">+ New Collection</a>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Name (EN)</th>
            <th>Launch Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var col in Model)
        {
            <tr>
                <td>@col.NameEn</td>
                <td>@(col.LaunchDate?.ToString("dd MMM yyyy") ?? "—")</td>
                <td>
                    <span class="badge @(col.IsActive ? "bg-success" : "bg-secondary")">
                        @(col.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="d-flex gap-1">
                    <a asp-action="Edit" asp-route-id="@col.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                    <form asp-action="Delete" asp-route-id="@col.Id" method="post"
                          onsubmit="return confirm('Delete @col.NameEn?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
