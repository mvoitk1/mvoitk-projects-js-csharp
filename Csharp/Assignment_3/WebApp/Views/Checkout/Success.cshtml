@{
    ViewData["Title"] = "Order Placed";
}

<div class="text-center py-5">
    <div class="mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor"
             class="text-success" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
        </svg>
    </div>
    <h2>Order Placed Successfully!</h2>
    @if (ViewData["OrderNumber"] != null)
    {
        <p class="text-muted">Order number: <strong>@ViewData["OrderNumber"]</strong></p>
    }
    <p>Thank you for your purchase. You can track your order in your account.</p>
    <div class="d-flex gap-3 justify-content-center mt-4">
        <a asp-controller="Orders" asp-action="Index" class="btn btn-dark">View My Orders</a>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary">Continue Shopping</a>
    </div>
</div>
