@model IEnumerable<App.DTO.v1.Admin.AdminCollectionDto>
@{
    ViewData["Title"] = "Collections";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="admin-eyebrow mb-1">Merchandising</p>
        <p class="text-muted mb-0">Create collections for launches, campaigns, and seasonal drops.</p>
    </div>
    <a asp-action="Create" class="btn btn-dark">New Collection</a>
</div>

@if (!Model.Any())
{
    <div class="admin-empty-state">
        <h3 class="h5 mb-2">No collections yet</h3>
        <p class="text-muted mb-3">Create a collection before attaching products to a launch or season.</p>
        <a asp-action="Create" class="btn btn-dark">Create Collection</a>
    </div>
}
else
{
    <div class="table-responsive admin-table-wrap">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name (EN)</th>
                    <th>Launch Date</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var col in Model)
                {
                    <tr>
                        <td>@col.NameEn</td>
                        <td>@(col.LaunchDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td>
                            <span class="badge @(col.IsActive ? "bg-success" : "bg-secondary")">
                                @(col.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@col.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                            <form asp-action="Delete" asp-route-id="@col.Id" method="post"
                                  onsubmit="return confirm('Delete @col.NameEn?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
