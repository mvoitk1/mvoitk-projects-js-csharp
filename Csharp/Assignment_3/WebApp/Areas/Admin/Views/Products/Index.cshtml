@model IEnumerable<App.DTO.v1.Admin.AdminProductDto>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Products</h2>
    <a asp-action="Create" class="btn btn-dark">+ New Product</a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Gender</th>
                <th>Collection</th>
                <th>Variants</th>
                <th>Active</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.NameEn</td>
                    <td>@p.Gender</td>
                    <td>@(p.CollectionName ?? "—")</td>
                    <td>@p.Variants.Count</td>
                    <td>
                        @if (p.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@p.CreatedAt.ToString("dd MMM yy")</td>
                    <td class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                              onsubmit="return confirm('Delete @p.NameEn?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
