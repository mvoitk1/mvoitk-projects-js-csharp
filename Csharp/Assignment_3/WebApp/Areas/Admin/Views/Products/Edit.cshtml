@model WebApp.Areas.Admin.ViewModels.ProductEditViewModel
@{
    ViewData["Title"] = "Edit Product";
    var product = Model.Product;
}

<p class="text-muted mb-3">Edit the product basics here. Variants and images stay below so you can test the full product setup in one place.</p>
<a asp-action="Index" class="text-decoration-none text-muted mb-4 d-inline-block">← Back to Products</a>

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="admin-form-grid mb-4">
    <div class="admin-form-panel">
        <form asp-action="Edit" asp-route-id="@product?.Id" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_ProductForm" model="Model"/>
            <button type="submit" class="btn btn-dark mt-3">Save Changes</button>
        </form>
    </div>
    @if (product != null)
    {
        <aside class="admin-form-aside">
            <h3 class="h6">Current product</h3>
            <dl class="small mb-0">
                <dt class="text-muted">Name (EN)</dt>
                <dd>@product.NameEn</dd>
                <dt class="text-muted">Name (ET)</dt>
                <dd>@(string.IsNullOrWhiteSpace(product.NameEt) ? "—" : product.NameEt)</dd>
                <dt class="text-muted">Collection</dt>
                <dd>@(product.CollectionName ?? "—")</dd>
                <dt class="text-muted">Variants</dt>
                <dd>@product.Variants.Count</dd>
                <dt class="text-muted">Images</dt>
                <dd>@product.Images.Count</dd>
            </dl>
        </aside>
    }
</div>

@if (product != null)
{
    <div class="admin-section-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Variants</h4>
        </div>

        @if (product.Variants.Any())
        {
            <div class="table-responsive admin-table-wrap mb-4">
                <table class="table align-middle">
                    <thead>
                        <tr><th>SKU</th><th>Color</th><th>Size</th><th>Price</th><th>Unit Price</th><th>Stock</th><th>Active</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in product.Variants)
                        {
                            <tr>
                                <td>@v.Sku</td>
                                <td>@v.ColorName</td>
                                <td>@v.SizeCode</td>
                                <td>@v.Price.ToString("C")</td>
                                <td>@v.UnitPrice.ToString("C")</td>
                                <td>@v.StockQty</td>
                                <td>@(v.IsActive ? "Yes" : "No")</td>
                                <td>
                                    <form asp-action="DeleteVariant" method="post"
                                          onsubmit="return confirm('Delete variant @v.Sku?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@product.Id">
                                        <input type="hidden" name="variantId" value="@v.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No variants yet.</p>
        }

        <h6>Add Variant</h6>
        <form asp-action="AddVariant" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@product.Id">
            <div class="col-md-2">
                <label class="form-label small">SKU</label>
                <input name="Sku" class="form-control form-control-sm" required>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Price (€)</label>
                <input name="Price" type="number" step="0.01" min="0" class="form-control form-control-sm" required>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Unit Price (€)</label>
                <input name="UnitPrice" type="number" step="0.01" min="0" class="form-control form-control-sm" required>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Stock</label>
                <input name="StockQty" type="number" min="0" class="form-control form-control-sm" value="0">
            </div>
            <div class="col-md-2">
                <label class="form-label small">Color</label>
                <select name="ColorId" asp-items="Model.Colors" class="form-select form-select-sm" required>
                    <option value="">-- color --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Size</label>
                <select name="SizeId" asp-items="Model.Sizes" class="form-select form-select-sm" required>
                    <option value="">-- size --</option>
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check mt-2">
                    <input id="variant-is-active" name="IsActive" type="checkbox" value="true" class="form-check-input" checked>
                    <input name="IsActive" type="hidden" value="false">
                    <label class="form-check-label small" for="variant-is-active">Active</label>
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark btn-sm w-100">Add Variant</button>
            </div>
        </form>
    </div>

    <div class="admin-section-card">
        <h4>Images</h4>

        @if (product.Images.Any())
        {
            <div class="row g-3 mb-4">
                @foreach (var img in product.Images)
                {
                    <div class="col-md-4 col-lg-3">
                        <div class="border rounded-2 p-2 h-100">
                            <img src="@img.Url" alt="@img.AltTextEn" width="100%" height="160"
                                 style="object-fit:cover;" class="rounded border mb-2">
                            <p class="small mb-1"><strong>Alt EN:</strong> @(string.IsNullOrWhiteSpace(img.AltTextEn) ? "—" : img.AltTextEn)</p>
                            <p class="small mb-1"><strong>Alt ET:</strong> @(string.IsNullOrWhiteSpace(img.AltTextEt) ? "—" : img.AltTextEt)</p>
                            <p class="small text-muted mb-2">Sort: @img.SortOrder</p>
                            <form asp-action="DeleteImage" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@product.Id">
                                <input type="hidden" name="imageId" value="@img.Id">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">Remove</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No images yet.</p>
        }

        <h6>Add Image</h6>
        <form asp-action="AddImage" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@product.Id">
            <div class="col-md-4">
                <label class="form-label small">Image File</label>
                <input name="imageFile" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control form-control-sm">
                <div class="form-text">Upload a file, or leave it empty and use an image URL instead.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label small">Image URL</label>
                <input name="Url" class="form-control form-control-sm" placeholder="https://...">
            </div>
            <div class="col-md-3">
                <label class="form-label small">Alt text (EN)</label>
                <input name="AltTextEn" class="form-control form-control-sm">
            </div>
            <div class="col-md-3">
                <label class="form-label small">Alt text (ET)</label>
                <input name="AltTextEt" class="form-control form-control-sm">
            </div>
            <div class="col-md-1">
                <label class="form-label small">Order</label>
                <input name="SortOrder" type="number" class="form-control form-control-sm" value="0">
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-dark btn-sm w-100">Add</button>
            </div>
        </form>
    </div>
}

@section Scripts { <partial name="_ValidationScriptsPartial"/> }
