@model App.Domain.Identity.RefreshToken

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>RefreshToken</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AppUser)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AppUser!.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Token)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Token)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TokenExpirationDateTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TokenExpirationDateTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PreviousToken)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PreviousToken)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PreviousTokenExpirationDateTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PreviousTokenExpirationDateTime)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
