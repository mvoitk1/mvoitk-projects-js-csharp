@model App.DTO.v1.Admin.AdminCategoryWriteDto
@{
    ViewData["Title"] = "Edit Category";
}

<h2>Edit Category</h2>
<a asp-action="Index" class="text-decoration-none text-muted mb-3 d-block">← Back</a>

<form asp-action="Edit" method="post" class="row g-3" style="max-width:500px;">
    @Html.AntiForgeryToken()
    <div class="col-12">
        <label asp-for="NameEn" class="form-label">Name (EN) *</label>
        <input asp-for="NameEn" class="form-control">
        <span asp-validation-for="NameEn" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="NameEt" class="form-label">Name (ET)</label>
        <input asp-for="NameEt" class="form-control">
    </div>
    <div class="col-12">
        <label asp-for="ParentCategoryId" class="form-label">Parent Category</label>
        <select asp-for="ParentCategoryId" asp-items="@(ViewData["Parents"] as SelectList)" class="form-select">
            <option value="">— None (top-level) —</option>
        </select>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-dark">Save</button>
    </div>
</form>
