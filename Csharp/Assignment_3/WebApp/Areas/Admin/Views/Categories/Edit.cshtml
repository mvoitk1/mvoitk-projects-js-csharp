@model App.DTO.v1.Admin.AdminCategoryWriteDto
@{
    ViewData["Title"] = "Edit Category";
}

<p class="text-muted mb-3">Update category names or move the category under a different parent.</p>
<a asp-action="Index" class="text-decoration-none text-muted mb-4 d-inline-block">← Back to Categories</a>

<div class="admin-form-grid">
    <div class="admin-form-panel">
        <form asp-action="Edit" method="post" class="row g-3" style="max-width:520px;">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
            <div class="col-12">
                <label asp-for="NameEn" class="form-label">Name (EN) *</label>
                <input asp-for="NameEn" class="form-control">
                <span asp-validation-for="NameEn" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="NameEt" class="form-label">Name (ET)</label>
                <input asp-for="NameEt" class="form-control">
            </div>
            <div class="col-12">
                <label asp-for="ParentCategoryId" class="form-label">Parent Category</label>
                <select asp-for="ParentCategoryId" asp-items="@(ViewData["Parents"] as SelectList)" class="form-select">
                    <option value="">— None (top-level) —</option>
                </select>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-dark">Save Category</button>
            </div>
        </form>
    </div>
    <aside class="admin-form-aside">
        <h3 class="h6">Test check</h3>
        <p class="text-muted small mb-0">After saving, confirm the updated name and parent relationship in the categories list.</p>
    </aside>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial"/> }
