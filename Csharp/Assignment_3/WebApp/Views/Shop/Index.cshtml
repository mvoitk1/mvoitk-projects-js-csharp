@model WebApp.ViewModels.ShopIndexViewModel
@{
    ViewData["Title"] = "Shop";
}

<div class="row g-0 mt-4">
    <!-- Filter Sidebar -->
    <div class="col-md-3 col-lg-2 pe-md-4 mb-4 mb-md-0">
        <div class="filter-sidebar">
            <h6>@App.Resources.Views.Shop.Index.Category</h6>
            <a asp-area="" asp-controller="Shop" asp-action="Index"
               class="@(Model.SelectedCategoryId == null ? "active-filter" : "")">@App.Resources.Views.Shop.Index.All</a>
            @foreach (var cat in Model.Categories)
            {
                <a asp-area="" asp-controller="Shop" asp-action="Index"
                   asp-route-categoryId="@cat.Id"
                   asp-route-collectionId="@Model.SelectedCollectionId"
                   asp-route-gender="@Model.SelectedGender"
                   class="@(Model.SelectedCategoryId == cat.Id ? "active-filter" : "")">
                    @cat.Name
                </a>
                @foreach (var sub in cat.SubCategories)
                {
                    <a asp-area="" asp-controller="Shop" asp-action="Index"
                       asp-route-categoryId="@sub.Id"
                       asp-route-collectionId="@Model.SelectedCollectionId"
                       asp-route-gender="@Model.SelectedGender"
                       class="ps-3 @(Model.SelectedCategoryId == sub.Id ? "active-filter" : "")">
                        @sub.Name
                    </a>
                }
            }

            <h6>@App.Resources.Views.Shop.Index.Collection</h6>
            <a asp-area="" asp-controller="Shop" asp-action="Index"
               asp-route-categoryId="@Model.SelectedCategoryId"
               asp-route-gender="@Model.SelectedGender"
               class="@(Model.SelectedCollectionId == null ? "active-filter" : "")">@App.Resources.Views.Shop.Index.All</a>
            @foreach (var col in Model.Collections)
            {
                <a asp-area="" asp-controller="Shop" asp-action="Index"
                   asp-route-collectionId="@col.Id"
                   asp-route-categoryId="@Model.SelectedCategoryId"
                   asp-route-gender="@Model.SelectedGender"
                   class="@(Model.SelectedCollectionId == col.Id ? "active-filter" : "")">
                    @col.Name
                </a>
            }

            <h6>@App.Resources.Views.Shop.Index.Gender</h6>
            @foreach (var g in new[] { ("", "All"), ("Men", "Men"), ("Women", "Women"), ("Unisex", "Unisex") })
            {
                <a asp-area="" asp-controller="Shop" asp-action="Index"
                   asp-route-gender="@g.Item1"
                   asp-route-categoryId="@Model.SelectedCategoryId"
                   asp-route-collectionId="@Model.SelectedCollectionId"
                   class="@(Model.SelectedGender == g.Item1 ? "active-filter" : "")">
                    @g.Item2
                </a>
            }
        </div>
    </div>

    <!-- Product grid -->
    <div class="col-md-9 col-lg-10">
        <div class="shop-page-header">
            <h1 class="section-heading">Shop</h1>
            <span class="shop-count">@Model.Products.Count() @App.Resources.Views.Shop.Index.Products</span>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="py-5 text-center">
                <p style="color:var(--c-text-muted);font-size:0.95rem;">@App.Resources.Views.Shop.Index.NoProducts</p>
                <a asp-area="" asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark btn-sm mt-2">Clear filters</a>
            </div>
        }
        else
        {
            <div class="row g-3 row-cols-2 row-cols-md-3">
                @foreach (var product in Model.Products)
                {
                    <div class="col">
                        <a asp-area="" asp-controller="Shop" asp-action="Detail" asp-route-id="@product.Id" class="product-card">
                            <div class="product-card-img-wrap">
                                @if (!string.IsNullOrEmpty(product.PrimaryImageUrl))
                                {
                                    <img src="@product.PrimaryImageUrl" alt="@product.Name">
                                }
                                else
                                {
                                    <div class="product-card-img-placeholder">No image</div>
                                }
                            </div>
                            <p class="product-card-name">@product.Name</p>
                            <p class="product-card-meta">@product.Gender</p>
                            @if (product.LowestPrice.HasValue)
                            {
                                <p class="product-card-price">@App.Resources.Views.Shop.Index.From @product.LowestPrice.Value.ToString("C")</p>
                            }
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>
