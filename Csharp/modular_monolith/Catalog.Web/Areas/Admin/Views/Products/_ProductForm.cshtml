@model Catalog.Web.Areas.Admin.ViewModels.ProductEditViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Name (EN) <span class="text-danger">*</span></label>
        <input asp-for="Form.NameEn" class="form-control">
        <span asp-validation-for="Form.NameEn" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Name (ET)</label>
        <input asp-for="Form.NameEt" class="form-control">
    </div>
    <div class="col-md-6">
        <label class="form-label">Description (EN)</label>
        <textarea asp-for="Form.DescriptionEn" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-md-6">
        <label class="form-label">Description (ET)</label>
        <textarea asp-for="Form.DescriptionEt" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-md-6">
        <label class="form-label">Material (EN)</label>
        <input asp-for="Form.MaterialEn" class="form-control">
    </div>
    <div class="col-md-6">
        <label class="form-label">Material (ET)</label>
        <input asp-for="Form.MaterialEt" class="form-control">
    </div>
    <div class="col-md-3">
        <label class="form-label">Gender</label>
        <select asp-for="Form.Gender" asp-items="Model.Genders" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Collection</label>
        <select asp-for="Form.CollectionId" asp-items="Model.Collections" class="form-select">
            <option value="">-- none --</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Categories</label>
        <select asp-for="Form.CategoryIds" asp-items="Model.Categories"
                class="form-select" multiple size="4"></select>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="Form.IsActive" class="form-check-input" type="checkbox">
            <label asp-for="Form.IsActive" class="form-check-label">Active (visible in shop)</label>
        </div>
    </div>
</div>
