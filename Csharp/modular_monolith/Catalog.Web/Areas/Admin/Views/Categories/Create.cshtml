@model Catalog.Web.Areas.Admin.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "New Category";
}

<p class="text-muted mb-3">Create categories first so products can be organized cleanly in the storefront.</p>
<a asp-action="Index" class="text-decoration-none text-muted mb-4 d-inline-block">← Back to Categories</a>

<div class="admin-form-grid">
    <div class="admin-form-panel">
        <form asp-action="Create" method="post" class="row g-3" style="max-width:520px;">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
            <div class="col-12">
                <label asp-for="Form.NameEn" class="form-label">Name (EN) *</label>
                <input asp-for="Form.NameEn" class="form-control">
                <span asp-validation-for="Form.NameEn" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Form.NameEt" class="form-label">Name (ET)</label>
                <input asp-for="Form.NameEt" class="form-control">
            </div>
            <div class="col-12">
                <label asp-for="Form.ParentCategoryId" class="form-label">Parent Category</label>
                <select asp-for="Form.ParentCategoryId" asp-items="Model.ParentOptions" class="form-select">
                    <option value="">— None (top-level) —</option>
                </select>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-dark">Create Category</button>
            </div>
        </form>
    </div>
    <aside class="admin-form-aside">
        <h3 class="h6">Where this shows up</h3>
        <p class="text-muted small mb-0">New products can be assigned to one or more categories from the product form.</p>
    </aside>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial"/> }
