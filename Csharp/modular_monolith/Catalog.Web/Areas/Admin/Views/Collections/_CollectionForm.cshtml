@model Catalog.Web.Dtos.v1.Admin.AdminCollectionWriteDto

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="NameEn" class="form-label">Name (EN) *</label>
        <input asp-for="NameEn" class="form-control">
        <span asp-validation-for="NameEn" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="NameEt" class="form-label">Name (ET)</label>
        <input asp-for="NameEt" class="form-control">
    </div>
    <div class="col-md-6">
        <label asp-for="DescriptionEn" class="form-label">Description (EN)</label>
        <textarea asp-for="DescriptionEn" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-md-6">
        <label asp-for="DescriptionEt" class="form-label">Description (ET)</label>
        <textarea asp-for="DescriptionEt" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-md-4">
        <label asp-for="LaunchDate" class="form-label">Launch Date</label>
        <input asp-for="LaunchDate" class="form-control" type="date">
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox">
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>
    </div>
</div>
