@model WebApp.Areas.Admin.ViewModels.OrderDetailViewModel
@{
    ViewData["Title"] = $"Order {Model.Order.OrderNumber}";
}

<a asp-action="Index" class="text-decoration-none text-muted mb-3 d-block">← Back to Orders</a>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2>@Model.Order.OrderNumber</h2>
        <p class="text-muted mb-0">@Model.Order.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
    </div>
    <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus" method="post" class="d-flex gap-2 align-items-center">
        <input type="hidden" name="id" value="@Model.Order.Id">
        <select name="status" asp-items="Model.Statuses"
                class="form-select form-select-sm" style="width:160px;"></select>
        <button type="submit" class="btn btn-dark btn-sm">Update Status</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h6>Items</h6>
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Product</th><th>Variant</th><th>Qty</th><th>Unit</th><th>Total</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Order.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td><small class="text-muted">@item.ColorName / @item.SizeCode</small></td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("C")</td>
                                <td>@item.LineTotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Total</td>
                            <td class="fw-bold">@Model.Order.TotalAmount.ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h6>Customer</h6>
                <p class="mb-1">@Model.Order.CustomerFirstName @Model.Order.CustomerLastName</p>
                <p class="text-muted small mb-0">@Model.Order.CustomerEmail</p>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6>Shipping Address</h6>
                <address class="mb-0 small">
                    <strong>@Model.Order.ShippingFirstName @Model.Order.ShippingLastName</strong><br>
                    @Model.Order.ShippingStreet<br>
                    @Model.Order.ShippingPostalCode @Model.Order.ShippingCity<br>
                    @Model.Order.ShippingCountry<br>
                    @Model.Order.ShippingEmail | @Model.Order.ShippingPhone
                </address>
            </div>
        </div>
    </div>
</div>
