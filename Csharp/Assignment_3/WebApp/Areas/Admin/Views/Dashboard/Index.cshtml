@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <h1 class="display-4">@ViewData["ProductCount"]</h1>
            <p class="text-muted mb-1">Products</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-dark">Manage</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <h1 class="display-4">@ViewData["OrderCount"]</h1>
            <p class="text-muted mb-1">Total Orders</p>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-dark">View</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <h1 class="display-4 text-warning">@ViewData["LowStockCount"]</h1>
            <p class="text-muted mb-1">Low Stock Variants (&lt;5)</p>
            <a asp-controller="Stock" asp-action="Index" class="btn btn-sm btn-outline-warning">Fix Stock</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <h1 class="display-4 text-success">@ViewData["RecentOrderCount"]</h1>
            <p class="text-muted mb-1">Orders (last 24h)</p>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-success">View</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Quick Actions</div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-controller="Products" asp-action="Create" class="btn btn-dark">+ New Product</a>
                <a asp-controller="Categories" asp-action="Create" class="btn btn-outline-dark">+ New Category</a>
                <a asp-controller="Collections" asp-action="Create" class="btn btn-outline-dark">+ New Collection</a>
            </div>
        </div>
    </div>
</div>
