@model IEnumerable<App.DTO.v1.Orders.OrderListItemDto>
@{
    ViewData["Title"] = "My Orders";
}

<h2 class="page-heading">@App.Resources.Views.Orders.Index.MyOrders</h2>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="text-muted">@App.Resources.Views.Orders.Index.NoOrders</p>
        <a asp-area="" asp-controller="Shop" asp-action="Index" class="btn btn-dark">@App.Resources.Views.Orders.Index.StartShopping</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>@App.Resources.Views.Orders.Index.OrderNumber</th>
                    <th>@App.Resources.Views.Orders.Index.Date</th>
                    <th>@App.Resources.Views.Orders.Index.Items</th>
                    <th>@App.Resources.Views.Orders.Index.Total</th>
                    <th>@App.Resources.Views.Orders.Index.Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>@order.OrderNumber</strong></td>
                        <td>@order.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>@order.ItemCount</td>
                        <td>@order.TotalAmount.ToString("C")</td>
                        <td>
                            <span class="badge @(order.Status == "Delivered" ? "bg-success" :
                                               order.Status == "Cancelled" ? "bg-danger" :
                                               order.Status == "Shipped" ? "bg-info" : "bg-secondary")">
                                @order.Status
                            </span>
                        </td>
                        <td>
                            <a asp-action="Detail" asp-route-id="@order.Id"
                               class="btn btn-sm btn-outline-dark">@App.Resources.Views.Orders.Index.View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
