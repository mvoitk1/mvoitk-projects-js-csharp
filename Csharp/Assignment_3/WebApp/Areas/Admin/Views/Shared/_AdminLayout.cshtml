@using WebApp.Helpers
@inject AppNameService AppNameService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Admin — @AppNameService.AppName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<div class="admin-shell">
    <nav class="admin-sidebar p-3 d-flex flex-column">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="text-white text-decoration-none d-block mb-1"
           style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;opacity:0.45;font-weight:600;">
            Admin
        </a>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="text-white text-decoration-none d-block mb-4"
           style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1.4rem;font-weight:500;letter-spacing:0.06em;">
            @AppNameService.AppName
        </a>
        @{
            var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
        }
        <ul class="nav flex-column gap-1 admin-nav">
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Dashboard" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Products" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Categories" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Collections" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Collections" asp-action="Index">Collections</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Orders" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Stock" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Stock" asp-action="Index">Stock</a>
            </li>
        </ul>

        <div class="admin-create-panel mt-4">
            <p class="admin-create-label mb-2">Quick Create</p>
            <div class="d-grid gap-2">
                <a class="btn btn-sm btn-light" asp-area="Admin" asp-controller="Products" asp-action="Create">New Product</a>
                <a class="btn btn-sm btn-outline-light" asp-area="Admin" asp-controller="Categories" asp-action="Create">New Category</a>
                <a class="btn btn-sm btn-outline-light" asp-area="Admin" asp-controller="Collections" asp-action="Create">New Collection</a>
            </div>
        </div>

        <div class="mt-auto pt-4">
            <hr style="border-color:rgba(255,255,255,0.1);margin-bottom:0.75rem;">
            <a class="nav-link" style="color:rgba(255,255,255,0.4);font-size:0.8rem;"
               asp-area="" asp-controller="Home" asp-action="Index">← Back to Shop</a>
        </div>
    </nav>

    <div class="admin-main flex-grow-1">
        <header class="admin-topbar">
            <div>
                <p class="admin-eyebrow mb-1">Admin workspace</p>
                <h1 class="admin-page-title mb-0">@ViewData["Title"]</h1>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-dark btn-sm" asp-area="Admin" asp-controller="Products" asp-action="Create">New Product</a>
                <a class="btn btn-outline-secondary btn-sm" asp-area="Admin" asp-controller="Categories" asp-action="Create">New Category</a>
                <a class="btn btn-outline-secondary btn-sm" asp-area="Admin" asp-controller="Collections" asp-action="Create">New Collection</a>
            </div>
        </header>

        <main class="p-4">
            @RenderBody()
        </main>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
