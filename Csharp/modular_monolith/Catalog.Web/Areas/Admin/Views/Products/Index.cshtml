@model IEnumerable<Catalog.Web.Dtos.v1.Admin.AdminProductDto>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="admin-eyebrow mb-1">Catalog</p>
        <p class="text-muted mb-0">Create products here, then open a product to add variants and images.</p>
    </div>
    <a asp-action="Create" class="btn btn-dark">New Product</a>
</div>

@if (!Model.Any())
{
    <div class="admin-empty-state">
        <h3 class="h5 mb-2">No products yet</h3>
        <p class="text-muted mb-3">Start the catalog by creating your first product.</p>
        <a asp-action="Create" class="btn btn-dark">Create Product</a>
    </div>
}
else
{
    <div class="table-responsive admin-table-wrap">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Name (ET)</th>
                    <th>Gender</th>
                    <th>Collection</th>
                    <th>Images</th>
                    <th>Variants</th>
                    <th>Active</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.NameEn</td>
                        <td>@(string.IsNullOrWhiteSpace(p.NameEt) ? "—" : p.NameEt)</td>
                        <td>@p.Gender</td>
                        <td>@(p.CollectionName ?? "—")</td>
                        <td>@p.Images.Count</td>
                        <td>@p.Variants.Count</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@p.CreatedAt.ToString("dd MMM yy")</td>
                        <td class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                                  onsubmit="return confirm('Delete @p.NameEn?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
