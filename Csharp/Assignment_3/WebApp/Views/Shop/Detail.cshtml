@using System.Text.Json
@model App.DTO.v1.Products.ProductDto
@{
    ViewData["Title"] = Model.Name;
    var variantsJson = JsonSerializer.Serialize(Model.Variants,
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<nav aria-label="breadcrumb" class="mt-3 mb-4">
    <ol class="breadcrumb" style="font-size:0.78rem;letter-spacing:0.04em;">
        <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" style="color:var(--c-text-muted);text-decoration:none;">Shop</a></li>
        <li class="breadcrumb-item active" style="color:var(--c-text-muted);">@Model.Name</li>
    </ol>
</nav>

<div class="row g-5" x-data="variantSelector(@Html.Raw(variantsJson))">
    <!-- Images -->
    <div class="col-md-6">
        @if (Model.Images.Any())
        {
            <div style="aspect-ratio:3/4;border-radius:var(--radius-md);overflow:hidden;background:var(--c-accent-bg);">
                <img :src="primaryImage" :alt="primaryAlt"
                     style="width:100%;height:100%;object-fit:cover;">
            </div>
            @if (Model.Images.Count > 1)
            {
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    @foreach (var img in Model.Images)
                    {
                        <img src="@img.Url" alt="@img.AltText"
                             class="thumbnail-img"
                             @@click="selectImage('@img.Url', '@img.AltText')">
                    }
                </div>
            }
        }
        else
        {
            <div style="aspect-ratio:3/4;border-radius:var(--radius-md);background:var(--c-accent-bg);display:flex;align-items:center;justify-content:center;">
                <span style="color:var(--c-text-placeholder);font-size:0.8rem;letter-spacing:0.05em;text-transform:uppercase;">No image</span>
            </div>
        }
    </div>

    <!-- Details & variant selector -->
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.CollectionName))
        {
            <p class="section-eyebrow mb-2">@Model.CollectionName</p>
        }
        <h1 style="font-family:var(--ff-serif);font-size:clamp(1.8rem,4vw,2.8rem);font-weight:400;line-height:1.1;margin-bottom:1rem;">@Model.Name</h1>

        <p class="detail-price mb-1" x-text="selectedPrice || '—'"></p>
        <p style="font-size:0.78rem;color:var(--c-text-muted);margin-bottom:1.75rem;" x-show="!selectedPrice">Select size to see price</p>

        <p style="font-size:0.92rem;line-height:1.7;color:var(--c-text-muted);margin-bottom:1.5rem;">@Model.Description</p>

        @if (!string.IsNullOrEmpty(Model.Material))
        {
            <p style="font-size:0.8rem;color:var(--c-text-muted);margin-bottom:1.5rem;">
                <span style="font-weight:600;text-transform:uppercase;letter-spacing:0.06em;font-size:0.7rem;">Material</span><br>
                @Model.Material
            </p>
        }

        <hr style="border-color:var(--c-border);margin-bottom:1.5rem;">

        <!-- Color selector -->
        @if (Model.Variants.Select(v => v.ColorId).Distinct().Count() > 1)
        {
            <div class="mb-4">
                <p class="detail-section-label">Color — <span x-text="selectedColorName" style="font-weight:400;text-transform:none;letter-spacing:0;"></span></p>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var color in Model.Variants.GroupBy(v => v.ColorId).Select(g => g.First()))
                    {
                        <button type="button"
                                class="color-swatch"
                                style="background-color:@color.ColorHex;"
                                title="@color.ColorName"
                                @@click="selectColor('@color.ColorId')"
                                :style="selectedColorId === '@color.ColorId' ? 'border-color: #0e0d0c; outline: 2px solid #0e0d0c; outline-offset: 2px;' : 'border-color: transparent;'">
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Size selector -->
        <div class="mb-4">
            <p class="detail-section-label">Size</p>
            <div class="d-flex gap-2 flex-wrap">
                @foreach (var size in Model.Variants.GroupBy(v => v.SizeId).Select(g => g.First()))
                {
                    <button type="button"
                            @@click="selectSize('@size.SizeId')"
                            :class="[
                                'size-btn',
                                selectedSizeId === '@size.SizeId' ? 'selected' : '',
                                !isSizeAvailable('@size.SizeId') ? 'out-of-stock' : ''
                            ]">
                        @size.SizeCode
                    </button>
                }
            </div>
        </div>

        <!-- Stock indicator -->
        <p class="mb-3" style="font-size:0.82rem;" x-show="selectedSizeId">
            <template x-if="selectedVariant && selectedVariant.stockQty > 0">
                <span style="color:#2d6a4f;">&#10003; In stock (<span x-text="selectedVariant.stockQty"></span> available)</span>
            </template>
            <template x-if="!selectedVariant || selectedVariant.stockQty === 0">
                <span style="color:#c62828;">&#10007; Out of stock — select a different size or colour</span>
            </template>
        </p>

        <!-- Add to cart -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Cart" asp-action="AddItem" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productVariantId" x-ref="variantInput">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn btn-dark btn-lg w-100"
                        :disabled="!selectedVariantId || selectedVariant?.stockQty === 0"
                        @@click="$refs.variantInput.value = selectedVariantId ?? ''">
                    Add to Cart
                </button>
            </form>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-dark btn-lg w-100">
                Login to purchase
            </a>
        }
    </div>
</div>

@section Scripts {
    <script>
        function variantSelector(variants) {
            return {
                variants,
                selectedColorId: null,
                selectedSizeId: null,
                primaryImage: '@(Model.Images.FirstOrDefault()?.Url ?? "")',
                primaryAlt: '@(Model.Images.FirstOrDefault()?.AltText ?? "")',

                init() {
                    // Auto-select the first color so size selection works immediately
                    const firstColor = this.variants[0]?.colorId;
                    if (firstColor) this.selectedColorId = firstColor;
                },

                get selectedVariant() {
                    if (!this.selectedColorId || !this.selectedSizeId) return null;
                    return this.variants.find(v =>
                        v.colorId === this.selectedColorId && v.sizeId === this.selectedSizeId
                    ) || null;
                },

                get selectedVariantId() {
                    return this.selectedVariant?.id || null;
                },

                get selectedPrice() {
                    if (!this.selectedVariant) return null;
                    return new Intl.NumberFormat(undefined, { style: 'currency', currency: 'EUR' })
                        .format(this.selectedVariant.price);
                },

                get selectedColorName() {
                    const v = this.variants.find(v => v.colorId === this.selectedColorId);
                    return v?.colorName || '';
                },

                selectColor(colorId) {
                    this.selectedColorId = colorId;
                    // Clear size selection if chosen size doesn't exist for the new colour
                    if (this.selectedSizeId) {
                        const still = this.variants.some(v =>
                            v.colorId === colorId && v.sizeId === this.selectedSizeId
                        );
                        if (!still) this.selectedSizeId = null;
                    }
                },

                selectSize(sizeId) {
                    this.selectedSizeId = sizeId;
                },

                isSizeAvailable(sizeId) {
                    if (!this.selectedColorId) return true;
                    return this.variants.some(v =>
                        v.colorId === this.selectedColorId && v.sizeId === sizeId && v.stockQty > 0
                    );
                },

                selectImage(url, alt) {
                    this.primaryImage = url;
                    this.primaryAlt = alt;
                }
            }
        }
    </script>
}
