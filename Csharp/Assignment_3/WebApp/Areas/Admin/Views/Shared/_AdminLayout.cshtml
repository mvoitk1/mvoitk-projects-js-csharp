@using WebApp.Helpers
@inject AppNameService AppNameService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Admin — @AppNameService.AppName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<div class="admin-shell d-lg-flex">
    <nav class="admin-sidebar bg-dark text-white p-3">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="text-white text-decoration-none fs-5 fw-bold d-block mb-4">
            @AppNameService.AppName Admin
        </a>
        @{
            var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
        }
        <ul class="nav flex-column gap-1 admin-nav">
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Dashboard" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Products" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Categories" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Collections" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Collections" asp-action="Index">Collections</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Orders" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ctrl == "Stock" ? "active-nav" : "")"
                   asp-area="Admin" asp-controller="Stock" asp-action="Index">Stock</a>
            </li>
        </ul>
        <div class="admin-create-panel mt-4">
            <p class="admin-create-label mb-2">Create</p>
            <div class="d-grid gap-2">
                <a class="btn btn-sm btn-light" asp-area="Admin" asp-controller="Products" asp-action="Create">New Product</a>
                <a class="btn btn-sm btn-outline-light" asp-area="Admin" asp-controller="Categories" asp-action="Create">New Category</a>
                <a class="btn btn-sm btn-outline-light" asp-area="Admin" asp-controller="Collections" asp-action="Create">New Collection</a>
            </div>
        </div>
        <hr class="border-secondary mt-4">
        <a class="nav-link text-white-50 small" asp-area="" asp-controller="Home" asp-action="Index">← Back to Shop</a>
    </nav>

    <div class="admin-main flex-grow-1">
        <header class="admin-topbar border-bottom">
            <div>
                <p class="admin-eyebrow mb-1">Admin workspace</p>
                <h1 class="admin-page-title mb-0">@ViewData["Title"]</h1>
            </div>
            <div class="admin-topbar-actions d-flex flex-wrap gap-2">
                <a class="btn btn-dark" asp-area="Admin" asp-controller="Products" asp-action="Create">New Product</a>
                <a class="btn btn-outline-dark" asp-area="Admin" asp-controller="Categories" asp-action="Create">New Category</a>
                <a class="btn btn-outline-dark" asp-area="Admin" asp-controller="Collections" asp-action="Create">New Collection</a>
            </div>
        </header>

        <main class="p-4">
            @RenderBody()
        </main>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
