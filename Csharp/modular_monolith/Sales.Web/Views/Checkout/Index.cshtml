@model Sales.Web.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<h1 class="section-heading mt-4 mb-4">Checkout</h1>

<form asp-action="Confirm" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- Shipping form -->
        <div class="col-md-7">
            <div class="checkout-panel">
                <h5 style="font-family:var(--ff-serif);font-size:1.25rem;font-weight:500;margin-bottom:1.5rem;">Shipping Details</h5>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ShippingFirstName" class="form-label"></label>
                        <input asp-for="ShippingFirstName" class="form-control">
                        <span asp-validation-for="ShippingFirstName" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ShippingLastName" class="form-label"></label>
                        <input asp-for="ShippingLastName" class="form-control">
                        <span asp-validation-for="ShippingLastName" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ShippingEmail" class="form-label"></label>
                        <input asp-for="ShippingEmail" class="form-control" type="email">
                        <span asp-validation-for="ShippingEmail" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ShippingPhone" class="form-label"></label>
                        <input asp-for="ShippingPhone" class="form-control" type="tel">
                        <span asp-validation-for="ShippingPhone" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="ShippingStreet" class="form-label"></label>
                        <input asp-for="ShippingStreet" class="form-control">
                        <span asp-validation-for="ShippingStreet" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ShippingCity" class="form-label"></label>
                        <input asp-for="ShippingCity" class="form-control">
                        <span asp-validation-for="ShippingCity" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ShippingPostalCode" class="form-label"></label>
                        <input asp-for="ShippingPostalCode" class="form-control">
                        <span asp-validation-for="ShippingPostalCode" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ShippingCountry" class="form-label"></label>
                        <input asp-for="ShippingCountry" class="form-control">
                        <span asp-validation-for="ShippingCountry" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order summary -->
        <div class="col-md-5">
            <div class="checkout-summary">
                <h5 style="font-family:var(--ff-serif);font-size:1.2rem;font-weight:500;margin-bottom:1.25rem;">
                    Your Order
                    <span style="font-weight:400;font-size:0.9rem;color:var(--c-text-muted);">(@Model.Cart.ItemCount items)</span>
                </h5>
                @foreach (var item in Model.Cart.Items)
                {
                    <div class="d-flex justify-content-between align-items-start mb-2" style="font-size:0.85rem;gap:0.5rem;">
                        <span style="color:var(--c-text-muted);flex:1;line-height:1.4;">
                            @item.ProductName
                            <span style="display:block;font-size:0.78rem;">@item.ColorName / @item.SizeCode × @item.Quantity</span>
                        </span>
                        <span style="white-space:nowrap;font-weight:500;">@item.LineTotal.ToString("C")</span>
                    </div>
                }
                <hr style="border-color:var(--c-border);margin:1rem 0;">
                <div class="d-flex justify-content-between">
                    <span style="font-weight:600;font-size:0.9rem;">Total</span>
                    <span style="font-family:var(--ff-serif);font-size:1.2rem;font-weight:500;">@Model.Cart.Total.ToString("C")</span>
                </div>
                <button type="submit" class="btn btn-dark w-100 btn-lg mt-3">Place Order</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
