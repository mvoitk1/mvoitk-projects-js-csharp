@model App.Domain.Todo.TodoCategory

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>TodoCategory</h4>
    <hr />

    @if (ViewData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (ViewData["DependentTaskCount"] is int count && count > 0)
    {
        <div class="alert alert-danger" role="alert">
            Cannot delete this category because it has @count dependent task(s). Remove or reassign the tasks first.
        </div>
    }

    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CategoryName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CategoryName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CategorySort)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CategorySort)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SyncDt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SyncDt)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        @if (ViewData["DependentTaskCount"] is int depCount && depCount > 0)
        {
            <input type="submit" value="Delete" class="btn btn-danger" disabled />
        }
        else
        {
            <input type="submit" value="Delete" class="btn btn-danger" />
        }
        |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
