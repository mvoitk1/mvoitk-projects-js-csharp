@model App.DTO.v1.Admin.AdminProductWriteDto

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Name (EN) <span class="text-danger">*</span></label>
        <input asp-for="NameEn" class="form-control">
        <span asp-validation-for="NameEn" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Name (ET)</label>
        <input asp-for="NameEt" class="form-control">
    </div>
    <div class="col-md-6">
        <label class="form-label">Description (EN)</label>
        <textarea asp-for="DescriptionEn" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-md-6">
        <label class="form-label">Description (ET)</label>
        <textarea asp-for="DescriptionEt" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-md-6">
        <label class="form-label">Material (EN)</label>
        <input asp-for="MaterialEn" class="form-control">
    </div>
    <div class="col-md-6">
        <label class="form-label">Material (ET)</label>
        <input asp-for="MaterialEt" class="form-control">
    </div>
    <div class="col-md-3">
        <label class="form-label">Gender</label>
        <select asp-for="Gender" asp-items="@(ViewData["Genders"] as SelectList)" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Collection</label>
        <select asp-for="CollectionId" asp-items="@(ViewData["Collections"] as SelectList)" class="form-select">
            <option value="">-- none --</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Categories</label>
        <select asp-for="CategoryIds" asp-items="@(ViewData["Categories"] as MultiSelectList)"
                class="form-select" multiple size="4"></select>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox">
            <label asp-for="IsActive" class="form-check-label">Active (visible in shop)</label>
        </div>
    </div>
</div>
