@model IEnumerable<App.DTO.v1.Admin.AdminOrderDto>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Orders</h2>
    <form method="get" class="d-flex gap-2 align-items-center">
        <label class="form-label mb-0">Filter:</label>
        <select name="status" asp-items="@(ViewData["Statuses"] as SelectList)"
                class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Statuses</option>
        </select>
    </form>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td><strong>@order.OrderNumber</strong></td>
                    <td>
                        @order.CustomerFirstName @order.CustomerLastName
                        <br><small class="text-muted">@order.CustomerEmail</small>
                    </td>
                    <td>@order.CreatedAt.ToString("dd MMM yy HH:mm")</td>
                    <td>@order.Items.Sum(i => i.Quantity)</td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>
                        <span class="badge @StatusBadge(order.Status)">@order.Status</span>
                    </td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@order.Id"
                           class="btn btn-sm btn-outline-dark">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@functions {
    static string StatusBadge(string status) => status switch
    {
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        "Shipped"   => "bg-info text-dark",
        "Confirmed" => "bg-primary",
        _           => "bg-secondary"
    };
}
